# Production defaults — COMMITTED ON PURPOSE.
#
# These are public business contact details, not secrets: they appear on every
# page of the site anyway. Committing them means a clone or a fresh Vercel /
# Netlify import works with no dashboard configuration.
#
# Precedence (Next.js): real environment variables set in the hosting dashboard
# override this file, and .env.local overrides it for local development. A real
# dealership should set its own values in the host dashboard rather than edit
# this file.
#
# Deliberately NOT set here: NEXT_PUBLIC_SITE_URL. It is only known after the
# first deployment, and a guessed domain must never be published as canonical.

NEXT_PUBLIC_WHATSAPP_NUMBER=2348129391626
NEXT_PUBLIC_CONTACT_EMAIL=growthly.business.scale@gmail.com
